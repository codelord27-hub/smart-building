# Optional: more headroom once the billing account is upgraded from the free trial
# (the free trial allows at most 8 vCPUs running at the same time).
#   terraform apply -var-file=terraform.tfvars -var-file=sizing-paid.tfvars
gke_machine_type      = "e2-standard-4"
gke_min_nodes         = 2
gke_max_nodes         = 4
dataproc_machine_type = "e2-standard-4"
